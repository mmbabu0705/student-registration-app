pipeline {
    agent any

    stages {
        stage('Checkout code') {
            steps {
                git branch: 'main', url: 'https://github.com/mmbabu0705/student-registration-app.git'
            }
        }
        stage('Compile code') {
            steps {
                sh 'mvn compile'
            }
        }
        stage('test code') {
            steps {
                sh 'mvn test'
            }
        }
        stage('package code') {
            steps {
                sh 'mvn package'
            }
        }
        stage('Deploy to tomcat') {
            steps {
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tomcat-cred', path: '', url: 'http://13.233.103.73:8080/')], contextPath: null, war: '**/*.war'
            }
        }
    }
}
